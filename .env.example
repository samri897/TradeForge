# Twelve Data API (https://twelvedata.com)
# Free tier: 800 API credits/day — enough for prototyping
EXPO_PUBLIC_TWELVE_DATA_API_KEY=your_twelve_data_api_key_here

# Alpha Vantage (fallback / fundamentals)
EXPO_PUBLIC_ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# WebSocket endpoint override (optional)
EXPO_PUBLIC_WS_URL=wss://ws.twelvedata.com/v1/quotes/price

# Alert polling interval in ms (background task)
EXPO_PUBLIC_ALERT_POLL_INTERVAL_MS=15000
